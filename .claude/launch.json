{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "backend/venv/Scripts/flask.exe",
      "runtimeArgs": [
        "--app",
        "shopdesk",
        "run",
        "-p",
        "5001"
      ],
      "cwd": "backend",
      "port": 5001,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "web"
      ],
      "cwd": "frontend",
      "port": 5173,
      "autoPort": false
    }
  ]
}
