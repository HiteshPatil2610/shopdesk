# ShopDesk backend environment template (local development)
# Copy to .env and fill in real values:   Copy-Item .env.example .env
# .env is NEVER committed. This file has placeholders only.
# Where each value comes from: SETUP_GUIDE.md §6. What each one does: §7.
# Production values live in Vercel project settings + GitHub secrets (SETUP_GUIDE §11), not in files.
# (SHOPDESK_SERVER=admin|pos is set only on Vercel. Locally, `flask --app admin_api|pos_api` picks the app.)

# ---------- General ----------
APP_ENV=development
LOG_LEVEL=DEBUG
TZ_DISPLAY=Asia/Kolkata
CURRENCY=INR

# ---------- Database: Neon branch "dev" (NEVER the "main" branch here) ----------
# Change Neon's "postgresql://" prefix to "postgresql+psycopg://" and keep "?sslmode=require..."
# Pooled (host contains -pooler): used by both running servers
DATABASE_URL=postgresql+psycopg://neondb_owner:CHANGE_ME@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct (no -pooler): used by migrations only
DATABASE_URL_UNPOOLED=postgresql+psycopg://neondb_owner:CHANGE_ME@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Automated tests: local PostgreSQL (DB name must end in _test)
TEST_DATABASE_URL=postgresql+psycopg://shopdesk:CHANGE_ME@localhost:5432/shopdesk_test
DB_POOL_SIZE=5
DB_ECHO=false

# ---------- Servers ----------
ADMIN_PORT=5001
POS_PORT=5002
ADMIN_CORS_ORIGINS=http://localhost:5173
POS_CORS_ORIGINS=http://localhost:5174

# ---------- Clerk (Development instance: pk_test_ / sk_test_) ----------
CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME
CLERK_SECRET_KEY=sk_test_CHANGE_ME
# PEM public key on ONE line, double-quoted, with \n for line breaks
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nCHANGE_ME\n-----END PUBLIC KEY-----"
ADMIN_AUTHORIZED_PARTIES=http://localhost:5173
POS_AUTHORIZED_PARTIES=http://localhost:5174
# Only needed when webhooks are set up (production / spec 10)
CLERK_WEBHOOK_SIGNING_SECRET=

# ---------- Cloudinary ----------
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=shopdesk-dev/products
# Keep under Vercel's ~4.5 MB request body limit
MAX_UPLOAD_MB=4

# ---------- Rate limiting ----------
# memory:// locally. Production (Vercel) must use Upstash Redis: rediss://default:PASSWORD@HOST:6379
RATELIMIT_STORAGE_URI=memory://

# ---------- Shop details (receipts) ----------
SHOP_NAME=My Shop
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_GSTIN=
RECEIPT_FOOTER=Thank you! Visit again

# ---------- Optional: manual backups from this laptop ----------
BACKUP_DIR=E:/Backups/ShopDesk
PG_BIN_DIR=C:/Program Files/PostgreSQL/18/bin
